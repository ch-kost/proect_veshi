{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django — история владения",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Консоль — история владения",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "justMyCode": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
